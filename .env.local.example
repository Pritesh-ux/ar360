# Phase 1 local/dev mode: works without MySQL.
AUTH_DEMO_MODE=true
AUTH_SECRET=change-this-local-secret

SEED_CUSTOMER_EMAIL=customer@arstudio.local
SEED_CUSTOMER_PASSWORD=Customer@12345
SEED_CUSTOMER_NAME=Demo Customer

SEED_ADMIN_EMAIL=admin@arstudio.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Master Admin

# When you are ready for real MySQL, set AUTH_DEMO_MODE=false and add:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=arstudio

# Keep false for local http://localhost testing. Set true only on HTTPS production.
AUTH_COOKIE_SECURE=false
