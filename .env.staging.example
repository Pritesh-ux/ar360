# AR360 STAGING environment template — copy to /var/www/ar360-staging/deploy/.env
# NEVER commit a real .env. Fill secrets only on the staging VPS.
# Do NOT reuse production secrets, DB, storage, or Razorpay LIVE keys.

AR360_DEPLOY_TARGET=staging

# Staging app URL (HTTPS staging subdomain)
NEXT_PUBLIC_APP_URL=https://staging.yourdomain.com
APP_URL=https://staging.yourdomain.com
AUTH_COOKIE_SECURE=true
PORT=3001

# Separate staging database (NOT arstudio)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ar360_staging
MYSQL_PASSWORD=replace-with-staging-db-password
MYSQL_DATABASE=arstudio_staging

# Generate unique staging secrets (do not copy from production)
AUTH_SECRET=replace-with-staging-auth-secret-min-32-chars
WORKER_SECRET=replace-with-staging-worker-secret-min-32-chars

# Razorpay TEST only on staging
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_test_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Staging SMTP (test mailbox / provider sandbox)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=staging-mailer@example.com
SMTP_PASSWORD=replace-with-staging-smtp-password
SMTP_FROM=AR360 Staging <staging-mailer@example.com>

# Optional: comma-separated emails allowed to self-register on staging (QA only)
# STAGING_SIGNUP_ALLOWLIST=qa1@example.com,qa2@example.com

SKIP_RUNTIME_DDL=true
ASSET_PROXY_ENFORCE=true

# Allowed on staging/CI only — leave unset on production
SMOKE_TEST_SECRET=replace-with-staging-smoke-secret

# Local storage under staging deploy tree (never point at production storage)
STORAGE_BACKEND=local
# STORAGE_ROOT=storage/Customers

# Optional staging Redis (separate DB index or instance from production)
# REDIS_URL=redis://127.0.0.1:6379/1
