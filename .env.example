# Local development — copy to .env.local and fill in values.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=arstudio

# Required in production (32+ random characters).
AUTH_SECRET=replace-with-a-long-random-secret

# Required in production for object-capture / background workers.
# Optional in local dev (worker endpoints allow access without it when NODE_ENV != production).
WORKER_SECRET=replace-with-a-long-random-worker-secret

# Razorpay — use your own test/live keys (never commit real secrets).
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that receive master-admin access on first signup.
AUTH_ADMIN_EMAILS=owner@example.com

SEED_ADMIN_EMAIL=admin@ar360.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Master Admin

SEED_CUSTOMER_EMAIL=customer@ar360.com
SEED_CUSTOMER_PASSWORD=Customer@12345
SEED_CUSTOMER_NAME=Demo Customer

# Keep false for local http://localhost. Set true on HTTPS production.
AUTH_COOKIE_SECURE=false

# Route customer GLB/assets through entitlement proxy.
# auto = enabled in production, disabled in development
# true | false to force
ASSET_PROXY_ENFORCE=auto

# Customer files on disk (default: storage/Customers outside public/)
# STORAGE_ROOT=C:/xampp/htdocs/ar360/storage/Customers

# Skip runtime CREATE/ALTER in production after migrations are applied.
# Defaults to true when NODE_ENV=production.
SKIP_RUNTIME_DDL=true

# Dev-only localStorage product cache (viewer/editor). Set true to force in production builds.
# NEXT_PUBLIC_LOCAL_PRODUCT_CACHE=false

# Optional email providers. Master Admin → Settings controls enabled providers.
# SMTP has first priority when enabled and fully configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=AR360 Studio <noreply@example.com>
# If SMTP is disabled or incomplete, Resend is used when enabled and configured.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=AR360 Studio <noreply@your-verified-domain.com>
# RESEND_REPLY_TO=support@your-domain.com

# Native Object Capture worker (direct MySQL; run with `npm run worker:oc`)
# OC_WORKER_INTERVAL_MS=15000
# OC_WORKER_ID=
# OC_LEASE_SECONDS=90
# OC_HEARTBEAT_MS=20000
# OC_STAGE_TIMEOUT_MS=7200000
# OC_GLOBAL_TIMEOUT_MS=28800000
# OC_CLEANUP_INTERVAL_MS=21600000
# OC_CLEANUP_WORKER_ID=
# OC_BACKLOG_WARNING_JOBS=10
# OC_QUEUE_AGE_WARNING_SECONDS=1800
# OC_PARTIAL_UPLOAD_RETENTION_HOURS=24
# OC_CANCELLED_RETENTION_DAYS=7
# OC_SOURCE_RETENTION_DAYS=30
# Per-plan overrides use OC_<PLAN>_CAPTURES_PER_MONTH,
# OC_<PLAN>_COMPUTE_SECONDS_PER_MONTH, OC_<PLAN>_CONCURRENT_JOBS, OC_<PLAN>_MAX_RETRIES.
# OC_PRO_CAPTURES_PER_MONTH=25
# OC_PRO_COMPUTE_SECONDS_PER_MONTH=180000
# OC_PRO_CONCURRENT_JOBS=2
# OC_PRO_MAX_RETRIES=3
# OBJECT_CAPTURE_STORAGE_ROOT=C:\ar360-data\object-capture
# Optional external processor used by the web orchestration path.
# OC_PROCESSOR_URL=
# OC_PROCESSOR_SECRET=
# OC_PROCESSOR_TIMEOUT_MS=120000
# COLMAP_PATH=C:\Program Files\COLMAP\bin\colmap.exe
# OPENMVS_INTERFACE_COLMAP_PATH=C:\OpenMVS\bin\InterfaceCOLMAP.exe
# OPENMVS_DENSIFY_PATH=C:\OpenMVS\bin\DensifyPointCloud.exe
# OPENMVS_RECONSTRUCT_PATH=C:\OpenMVS\bin\ReconstructMesh.exe
# OPENMVS_REFINE_PATH=C:\OpenMVS\bin\RefineMesh.exe
# OPENMVS_TEXTURE_PATH=C:\OpenMVS\bin\TextureMesh.exe
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
# Docker app/worker IDs must match so the shared named volume remains writable.
# APP_UID=1001
# APP_GID=1001

# Staging/CI only — enables POST /api/internal/smoke-login (never set in production)
# SMOKE_TEST_SECRET=replace-with-random-staging-secret

# Optional error monitoring (Sentry)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENABLED=true

# Optional Redis for distributed rate limiting (falls back to in-memory when unset)
# REDIS_URL=redis://localhost:6379

# Storage backend: local (default) or s3
# STORAGE_BACKEND=local
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=           # MinIO / compatible S3 endpoint
# AWS_S3_FORCE_PATH_STYLE=true  # required for MinIO

# Local MinIO (docker compose --profile s3 up)
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=minio123456

# Optional CDN base for public asset URLs (CloudFront, etc.)
# ASSET_CDN_BASE=https://cdn.example.com
# NEXT_PUBLIC_ASSET_CDN_BASE=https://cdn.example.com

# Job queue backend: db (default) or redis
# JOB_QUEUE_BACKEND=db
# REDIS_URL=redis://localhost:6379

# Optional single-url form:
# MYSQL_URL=mysql://user:password@localhost:3306/arstudio

# Encrypts platform secrets stored via Master Admin settings
BILLING_SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string
